# Data source: mock (default) or supabase.
VITE_DATA_SOURCE=mock

# Mock data (VITE_DATA_SOURCE=mock only).
VITE_MOCK_SCENARIO=default
VITE_MOCK_TEAM_ROLE=owner
VITE_MOCK_LATENCY_MS=400
VITE_MOCK_FAIL_RATE=0

# Supabase (VITE_DATA_SOURCE=supabase). `npm run dev:supabase` reads `.env.supabase` and
# `.env.supabase.local` (written by `npm run db:env`), so the local stack needs nothing here.
# Never put the secret key in a VITE_* variable.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_GOOGLE_SIGN_IN=true
